# Feishu / Lark bridge configuration
# Copy to ~/.agents-to-im/config.env and edit

# Default working directory for all new sessions
CTI_DEFAULT_WORKDIR=/path/to/your/project

# Default mode passed to new bindings: code | plan | ask
CTI_DEFAULT_MODE=code

# Feishu / Lark profiles
CTI_FEISHU_PROFILE_IDS=default
CTI_FEISHU_PROFILE_DEFAULT_APP_ID=your-app-id
CTI_FEISHU_PROFILE_DEFAULT_APP_SECRET=your-app-secret
CTI_FEISHU_PROFILE_DEFAULT_LABEL=Default Bot
# Optional: set to "lark" for Lark international, defaults to Feishu
# CTI_FEISHU_PROFILE_DEFAULT_DOMAIN=lark
# Optional allowlist (open_id / user_id / union_id)
# CTI_FEISHU_PROFILE_DEFAULT_ALLOWED_USERS=ou_xxx,ou_yyy
# Optional profile-local presentation switches
# CTI_FEISHU_PROFILE_DEFAULT_TOOL_OUTPUT_CARDS=true
# CTI_FEISHU_PROFILE_DEFAULT_AUTO_IMAGE_SEND=true

# Runtime -> Feishu profile mapping
CTI_RUNTIME_CLAUDE_FEISHU_PROFILE=default
CTI_RUNTIME_CODEX_FEISHU_PROFILE=default

# Claude runtime
# Optional default model for /new:claude
# CTI_CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
# Optional explicit Claude CLI path
# CTI_CLAUDE_CODE_EXECUTABLE=/path/to/claude

# Codex runtime
# Reuses the user's local ~/.codex/config.toml (or $CODEX_HOME/config.toml)
# for auth, trusted directories, sandbox, approval policy, and default model behavior
# Ensure `codex` CLI is already installed and authenticated on this machine
# Optional default model for /new:codex
# CTI_CODEX_DEFAULT_MODEL=gpt-5-codex

# Auto-approve all tool permission requests
# Keep disabled unless the bot is deployed in a trusted environment
# CTI_AUTO_APPROVE=true

# Optional third-party Claude API passthrough
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
